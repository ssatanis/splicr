{
  "name": "splicr",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "ensure-share-columns": "node scripts/ensure-analysis-share-columns.mjs",
    "seed:libraries": "node scripts/seed-libraries.mjs",
    "seed:all": "node scripts/seed-all-libraries.mjs",
    "build": "cd frontend && NODE_OPTIONS=--max-old-space-size=8192 npm ci --include=dev && NODE_OPTIONS=--max-old-space-size=8192 npm run build",
    "dev": "cd frontend && npm run dev",
    "start": "cd frontend && npm run start",
    "dev:electron": "cd frontend && npm run dev:electron",
    "build:electron": "cd frontend && npm run build:electron",
    "build:electron:mac": "cd frontend && npm run build:electron:mac",
    "build:electron:win": "cd frontend && npm run build:electron:win",
    "build:electron:linux": "cd frontend && npm run build:electron:linux"
  },
  "dependencies": {
    "@react-email/components": "^1.0.6",
    "@react-email/render": "^2.0.4",
    "@upstash/redis": "^1.36.2",
    "bullmq": "^5.67.2",
    "ioredis": "^5.9.2",
    "next": "15.5.11",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "pg": "^8.18.0",
    "xlsx": "^0.18.5"
  }
}
