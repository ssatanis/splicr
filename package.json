{
  "name": "splicr",
  "version": "0.1.0",
  "private": true,
  "description": "SplicR | CRISPR Screen Evidence",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "db:push": "node scripts/db/push.mjs",
    "db:status": "node scripts/db/status.mjs",
    "db:types": "npx supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" --schema public > packages/db/src/database.types.ts",
    "evidence:generate": "python3 scripts/research/publish_evidence.py",
    "evidence:check": "node scripts/research/evidence_gate.mjs --check-public",
    "test:web": "node --test apps/web/tests/*.test.mjs",
    "emails:auth": "node apps/web/scripts/build-auth-emails.mjs",
    "emails:auth:check": "node apps/web/scripts/build-auth-emails.mjs --check",
    "data:nih": "node scripts/data/nih-summary.mjs",
    "data:seed": "node scripts/data/seed-atlas.mjs",
    "atlas:snapshot": "engine/.tools/env/bin/python scripts/data/build-atlas-snapshot.py",
    "atlas:check": "engine/.tools/env/bin/python scripts/data/build-atlas-snapshot.py --check",
    "db:advisors": "node scripts/db/advisors.mjs",
    "auth:provision": "node scripts/auth/provision-researcher.mjs",
    "e2e": "npm run e2e -w apps/web",
    "e2e:live": "npm run e2e:live -w apps/web",
    "validation:export": "engine/.tools/env/bin/python scripts/validation/export_endpoints.py",
    "validation:check": "engine/.tools/env/bin/python scripts/validation/export_endpoints.py --check",
    "validation:status": "PYTHONPATH=engine engine/.tools/env/bin/python -m splicr validation status",
    "test:validation": "node --test apps/web/tests/validation-contract.test.mjs apps/web/tests/endpoint-decisions.test.mjs apps/web/tests/validation-network.test.mjs apps/web/tests/validation-network-render.test.mjs apps/web/tests/receipt-canonical.test.mjs",
    "test:engine": "cd engine && PYTHONPATH=. .tools/env/bin/python -m pytest -q -m \"not network and not slow\""
  },
  "devDependencies": {
    "pg": "^8.18.0",
    "pg-copy-streams": "^7.0.0",
    "supabase": "^2.118.0"
  }
}
