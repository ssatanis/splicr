# See .env.local for your actual values. Copy this to .env.local and fill in.

# Backend / API (used by Next.js API routes)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (server-side, for API routes)
DATABASE_URL=

# Redis (optional; for Celery task status when using full backend)
REDIS_URL=redis://localhost:6379/0

# API rate limits (Tier 6; requests per minute)
API_RATE_LIMIT_STANDARD=100
API_RATE_LIMIT_PRO=500
API_RATE_LIMIT_ENTERPRISE=2000

# Cloudflare R2 (for FASTQ file storage - free tier: 10GB)
R2_ACCOUNT_ID=your_account_id_from_cloudflare_dashboard
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=splicr-fastq-files
# Endpoint: base URL only, no path (e.g. https://<account_id>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Browser-accessible R2 (same credentials for direct upload)
NEXT_PUBLIC_R2_ACCESS_KEY_ID=your_r2_access_key
NEXT_PUBLIC_R2_SECRET_ACCESS_KEY=your_r2_secret_key
NEXT_PUBLIC_R2_BUCKET_NAME=splicr-fastq-files
NEXT_PUBLIC_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
