# Redis Configuration (Upstash recommended for production)
# Use rediss:// for TLS (required by Upstash)
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@striking-wallaby-46693.upstash.io:6379
# Or set password separately if using REDIS_URL without credentials:
# REDIS_PASSWORD=your_upstash_token
REDIS_DB=0

# Queue Settings
QUEUE_CONCURRENCY=4
QUEUE_MAX_RETRIES=3
QUEUE_JOB_TIMEOUT_MS=14400000  # 4 hours
QUEUE_RETENTION_DAYS=7

# Worker Settings
WORKER_ID=worker-1
WORKER_HEARTBEAT_INTERVAL_MS=30000  # 30 seconds
WORKER_PROGRESS_UPDATE_INTERVAL_MS=5000  # 5 seconds

# Analysis Settings
ANALYSIS_MAX_DURATION_HOURS=4
ANALYSIS_CHECKPOINT_INTERVAL_STEPS=5

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
