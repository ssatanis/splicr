# See .env.local for your actual values. Copy this to frontend/.env.local and fill in.
# Next.js only loads .env from the frontend/ directory. If you use a root .env.local,
# copy NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY here and restart dev.

# Backend / API (used by Next.js API routes)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (use Client Key from Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Client key: prefer publishable key (sb_publishable_...) or anon JWT
NEXT_PUBLIC_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (server-side, for API routes)
DATABASE_URL=

# Pipeline results push (server-side; for MAGeCK/BAGEL2/DRUGZ to save results to DB)
# Call POST /api/analysis/{id}/results/push with Bearer token or ?secret= this value
ANALYSIS_WRITE_SECRET=

# Redis (optional; for Celery task status when using full backend)
REDIS_URL=redis://localhost:6379/0

# API rate limits (Tier 6; requests per minute)
API_RATE_LIMIT_STANDARD=100
API_RATE_LIMIT_PRO=500
API_RATE_LIMIT_ENTERPRISE=2000

# Cloudflare R2 (for FASTQ file storage - free tier: 10GB)
# These are SERVER-SIDE ONLY credentials - never expose to browser
# Browser uploads use presigned URLs generated by /api/upload/presign
R2_ACCOUNT_ID=your_account_id_from_cloudflare_dashboard
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=splicr-fastq-files
# Endpoint: base URL only, no path (e.g. https://<account_id>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
