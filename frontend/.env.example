# Redis Configuration (Upstash recommended for production)
# Option A: Redis URL (TCP/TLS). Use rediss:// for Upstash.
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@your-database.upstash.io:6379
# Option B: Upstash REST API vars (we derive rediss:// for BullMQ automatically)
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
# Or set password separately if using REDIS_URL without credentials:
# REDIS_PASSWORD=your_upstash_token
REDIS_DB=0

# Queue Settings
QUEUE_CONCURRENCY=4
QUEUE_MAX_RETRIES=3
QUEUE_JOB_TIMEOUT_MS=14400000  # 4 hours
QUEUE_RETENTION_DAYS=7

# Worker Settings
WORKER_ID=worker-1
WORKER_HEARTBEAT_INTERVAL_MS=30000  # 30 seconds
WORKER_PROGRESS_UPDATE_INTERVAL_MS=5000  # 5 seconds

# Analysis Settings
ANALYSIS_MAX_DURATION_HOURS=4
ANALYSIS_CHECKPOINT_INTERVAL_STEPS=5

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
