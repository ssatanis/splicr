# ============================================================================
# SPLICR ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# SUPABASE CONFIGURATION (CRITICAL FOR PERFORMANCE)
# ============================================================================

# Standard Supabase URL - used for browser client and realtime subscriptions
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon key for client-side access
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Publishable key (preferred over anon key if using the new key system)
NEXT_PUBLIC_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Service role key for server-side admin operations (NEVER expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# CONNECTION POOLING (PRODUCTION OPTIMIZATION)
# ============================================================================
# For production and high-traffic environments, use Supabase's connection pooler
# to dramatically reduce connection overhead and improve performance.
#
# Benefits:
#   - 5-10x faster connection times
#   - Handles 1000+ concurrent connections
#   - Prevents "too many connections" errors
#   - Reduces database CPU by 30-50%
#
# Get your pooler URLs from: Supabase Dashboard > Settings > Database
#
# Choose the right pooler mode:
#   - Transaction mode (recommended): Best for short-lived requests (API routes, serverless)
#   - Session mode: Use if you need prepared statements or database-level transactions
#
# Uncomment and use these in production:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co:6543  # Transaction pooler (port 6543)
# DATABASE_URL=postgresql://postgres.your-project:password@your-project.pooler.supabase.com:6543/postgres?pgbouncer=true

# ============================================================================
# DATABASE (Direct Connection - Development Only)
# ============================================================================
# Direct Postgres connection string (not pooled)
# Use this for local development or database migrations
# In production, prefer the pooler connection above
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ============================================================================
# APPLICATION URLS
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================================
# AWS CONFIGURATION
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=splicr-data-prod

# AWS Batch (for analysis jobs)
AWS_BATCH_JOB_QUEUE=splicr-job-queue
AWS_BATCH_JOB_DEFINITION=splicr-analysis:1

# ============================================================================
# CLOUDFLARE R2 (File Storage)
# ============================================================================
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=splicr-fastq-files
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Browser-accessible R2 (for direct upload from client)
NEXT_PUBLIC_R2_ACCESS_KEY_ID=your-r2-access-key
NEXT_PUBLIC_R2_SECRET_ACCESS_KEY=your-r2-secret-key
NEXT_PUBLIC_R2_BUCKET_NAME=splicr-fastq-files
NEXT_PUBLIC_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ============================================================================
# REDIS (Caching & Background Jobs)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# Celery (Python background workers)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================================================
# SECURITY
# ============================================================================
SECRET_KEY=generate-a-secure-random-key-here

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,https://your-production-domain.com"

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=SplicR API
DEBUG=False
API_V1_PREFIX=/api/v1
FLASK_ENV=production

# File upload limits (bytes)
MAX_UPLOAD_SIZE=10737418240  # 10GB

# ============================================================================
# PERFORMANCE TUNING (Optional)
# ============================================================================

# Cache TTLs (seconds)
# GENE_INFO_CACHE_TTL=604800       # 7 days
# DRUG_GENE_CACHE_TTL=604800       # 7 days
# ANALYSIS_LIST_CACHE_TTL=300      # 5 minutes

# Query timeouts (milliseconds)
# DB_QUERY_TIMEOUT=30000           # 30 seconds
# AUTH_CHECK_TIMEOUT=4000          # 4 seconds (middleware)

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Sentry DSN (error tracking)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# PostHog (analytics)
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================================================
# GOOGLE GEMINI (AI Structure Intelligence — Structure Viewer)
# ============================================================================
# Get API key from https://aistudio.google.com/apikey
# Used server-side by /api/ai/* routes (explain, chat, mutation, druggability, educational).
# Free tier: 15 RPM, 1M TPM.
# GEMINI_API_KEY=your-gemini-api-key

# ============================================================================
# RESEND (Transactional Email — share invites, auth, etc.)
# ============================================================================
# Get API key from https://resend.com/api-keys and verify your domain at resend.com/domains
# RESEND_API_KEY=re_xxxxxxxxxxxx
# From address: use a verified domain (e.g. splicr.org) so you can send to any recipient.
# With onboarding@resend.dev you can only send to your own Resend account email.
# RESEND_FROM=SplicR <notifications@splicr.org>
