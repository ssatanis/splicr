{
  "name": "splicr-frontend",
  "version": "1.0.0",
  "description": "SplicR - CRISPR Screen Analysis Platform (web and desktop)",
  "homepage": "https://splicr.org",
  "author": "SplicR <team@splicr.org>",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "main": "main/background.js",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "npm run clean && next dev",
    "build": "next build",
    "build:clean": "npm run clean && next build",
    "start": "next start",
    "clean": "rm -rf .next node_modules/.cache",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "dev:electron": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 -t 60000 && node electron.js\"",
    "build:electron": "node electron-build.js --mac --win --linux",
    "build:electron:mac": "node electron-build.js --mac",
    "build:electron:win": "node electron-build.js --win",
    "build:electron:linux": "node electron-build.js --linux"
  },
  "build": {
    "appId": "com.splicr.app",
    "productName": "SplicR",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main",
      "out",
      "!out/**/*.map"
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build-resources/icon.icns",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-",
      "type": "development",
      "extendInfo": {
        "NSSupportsAutomaticGraphicsSwitching": true,
        "NSHighResolutionCapable": true,
        "LSMinimumSystemVersion": "11.0"
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build-resources/icon-256.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build-resources/icon-512.png",
      "maintainer": "SplicR <team@splicr.org>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Science"
    },
    "publish": null
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/lib-storage": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@floating-ui/dom": "^1.7.5",
    "@google/generative-ai": "^0.24.1",
    "@smithy/node-http-handler": "^4.4.8",
    "@stdlib/stats": "^0.3.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.3",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tiptap/extension-image": "^3.18.0",
    "@tiptap/extension-placeholder": "^3.18.0",
    "@tiptap/pm": "^3.18.0",
    "@tiptap/react": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "@types/pako": "^2.0.4",
    "autoprefixer": "^10",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "fast-stats": "^0.0.7",
    "file-saver": "^2.0.5",
    "force-graph": "^1.51.0",
    "framer-motion": "^11.0.0",
    "gifenc": "^1.0.3",
    "hierarchical-clustering": "^1.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "katex": "^0.16.28",
    "konva": "^10.2.0",
    "lucide-react": "^0.344.0",
    "mathjs": "^15.1.0",
    "next": "16.1.6",
    "ngl": "^2.4.0",
    "pako": "^2.1.0",
    "papaparse": "^5.5.3",
    "plotly.js-dist-min": "^3.3.1",
    "postcss": "^8",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-konva": "^18.2.14",
    "react-plotly.js": "^2.6.0",
    "recharts": "^3.7.0",
    "resend": "^4.0.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.1",
    "electron": "^33.3.1",
    "electron-builder": "^26.7.0",
    "electron-icon-builder": "^2.0.1",
    "electron-serve": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.2.0",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  }
}
