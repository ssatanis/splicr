CORS_ORIGINS=["https://splicr.bio","https://www.splicr.bio","https://app.splicr.bio","http://localhost:3000"]

# ==========================================
# APPLICATION
# ==========================================
APP_NAME=SplicR API
DEBUG=false
API_V1_PREFIX=/api/v1
NODE_ENV=production
PYTHONUNBUFFERED=1

# ==========================================
# FILE UPLOAD
# ==========================================
MAX_UPLOAD_SIZE=10737418240
ALLOWED_EXTENSIONS=.fastq,.fq,.fastq.gz,.fq.gz

# ==========================================
# AWS BATCH (For Analysis Jobs)
# ==========================================
# NOTE: If not using AWS Batch, set these to placeholder values
# The system will gracefully handle missing Batch configuration
