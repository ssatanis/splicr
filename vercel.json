{
  "installCommand": "npm ci --include=dev",
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=8192"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/redis-ping",
      "schedule": "0 0 * * *"
    }
  ]
}