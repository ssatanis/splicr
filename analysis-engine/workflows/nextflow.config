/*
 * Nextflow configuration for SplicR
 */

// Manifest
manifest {
    name = 'SplicR'
    author = 'SplicR Team'
    homePage = 'https://splicr.bio'
    description = 'CRISPR screen analysis pipeline'
    mainScript = 'main.nf'
    version = '1.0.0'
    nextflowVersion = '>=23.0.0'
}

// Parameters
params {
    // Execution
    max_cpus = 8
    max_memory = '32.GB'
    max_time = '6.h'
    
    // AWS
    aws_region = 'us-east-1'
    
    // Output
    publish_dir_mode = 'copy'
}

// Process configuration
process {
    executor = 'awsbatch'
    queue = params.batch_queue ?: 'splicr-job-queue'
    
    errorStrategy = 'retry'
    maxRetries = 2
    
    // Resource defaults
    cpus = 4
    memory = '16.GB'
    time = '4.h'
    
    // Container settings
    container = 'splicr/analysis:latest'
    
    // Process-specific settings
    withName: MAGECK_COUNT {
        cpus = 4
        memory = '16.GB'
        time = '2.h'
        container = 'splicr/mageck:latest'
    }
    
    withName: MAGECK_TEST {
        cpus = 2
        memory = '8.GB'
        time = '1.h'
        container = 'splicr/mageck:latest'
    }
    
    withName: BAGEL2 {
        cpus = 2
        memory = '8.GB'
        time = '1.h'
        container = 'splicr/bagel2:latest'
    }
    
    withName: DRUGZ {
        cpus = 2
        memory = '8.GB'
        time = '1.h'
        container = 'splicr/drugz:latest'
    }
    
    withName: VISUALIZATION {
        cpus = 2
        memory = '8.GB'
        time = '30.m'
        container = 'splicr/visualization:latest'
    }
}

// Executor configuration
executor {
    name = 'awsbatch'
    queueSize = 100
    pollInterval = '30 sec'
    submitRateLimit = '10/1min'
}

// AWS configuration
aws {
    region = params.aws_region
    batch {
        cliPath = '/home/ec2-user/miniconda/bin/aws'
        maxParallelTransfers = 4
        maxTransferAttempts = 3
    }
}

// Docker configuration
docker {
    enabled = true
    temp = 'auto'
    remove = true
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
        docker.enabled = true
    }
    
    awsbatch {
        process.executor = 'awsbatch'
        process.queue = params.batch_queue
        aws.region = params.aws_region
    }
    
    local {
        process.executor = 'local'
        docker.enabled = true
        process.cpus = 4
        process.memory = '16.GB'
    }
    
    test {
        process.executor = 'local'
        docker.enabled = false
    }
}

// Reporting
timeline {
    enabled = true
    file = "${params.outdir}/timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/dag.svg"
}
