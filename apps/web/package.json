{
  "name": "@splicr/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "build": "node scripts/copy-vendor.mjs && node ../../scripts/research/evidence_gate.mjs --check-public && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "vendor": "node scripts/copy-vendor.mjs",
    "e2e": "playwright test --project=fast",
    "e2e:live": "playwright test --project=live",
    "e2e:seed": "node e2e/fixtures/seed.cjs seed",
    "e2e:teardown": "node e2e/fixtures/seed.cjs teardown"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.52.0",
    "modal": "^0.11.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "pdbe-molstar": "3.12.0",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-force-graph-2d": "^1.29.2",
    "recharts": "^3.10.1",
    "resend": "^6.30.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.0",
    "three": "0.182.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
