# SplicR Analysis Worker - Production-Grade CRISPR Screening Platform
# Includes: MAGeCK (RRA + MLE), BAGEL2, DrugZ
# Node.js 24 + Python 3.11 + Scientific Computing Stack
FROM node:24-bookworm-slim

# Install system dependencies for Python, scientific computing, and Git
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    build-essential \
    git \
    curl \
    ca-certificates \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python scientific stack first (for dependency resolution)
RUN pip3 install --no-cache-dir --break-system-packages \
    numpy==1.24.3 \
    scipy==1.10.1 \
    pandas==2.0.3 \
    matplotlib==3.7.2 \
    seaborn==0.12.2

# Install MAGeCK (includes both RRA and MLE algorithms) - Build from source
# Using version 0.5.9.5 via Bitbucket mirror or GitHub
RUN git clone https://bitbucket.org/liulab/mageck.git /opt/mageck && \
    cd /opt/mageck && \
    git checkout v0.5.9.5 && \
    python3 setup.py install

# Install BAGEL2 (Bayesian Analysis of Gene Essentiality)
RUN git clone https://github.com/hart-lab/bagel.git /opt/bagel2 && \
    cd /opt/bagel2 && \
    chmod +x BAGEL.py && \
    pip3 install --no-cache-dir --break-system-packages -r requirements.txt 2>/dev/null || true

# Install DrugZ (Drug-Gene Interaction Analysis)
RUN git clone https://github.com/hart-lab/drugz.git /opt/drugz && \
    cd /opt/drugz && \
    chmod +x drugz.py

# Add algorithm executables to PATH
ENV PATH="/opt/bagel2:/opt/drugz:${PATH}"
ENV PYTHONPATH="/opt/bagel2:/opt/drugz:${PYTHONPATH}"

# Verify all algorithms are installed and accessible
RUN echo "=== Verifying Algorithm Installations ===" && \
    mageck -h 2>&1 | head -5 && \
    python3 /opt/bagel2/BAGEL.py -h 2>&1 | head -5 && \
    python3 /opt/drugz/drugz.py -h 2>&1 | head -5 && \
    echo "=== All algorithms installed successfully ==="

# Set working directory
WORKDIR /app

# Copy root package files
COPY package*.json ./

# Copy frontend package files and install dependencies
COPY frontend/package*.json frontend/
RUN cd frontend && npm ci --only=production

# Copy application code (use .dockerignore to exclude unnecessary files)
COPY . .

# Verify frontend node_modules exist
RUN test -d frontend/node_modules || (echo "ERROR: frontend/node_modules missing" && exit 1)

# Create worker entrypoint script
RUN echo '#!/bin/sh\nset -e\necho "🚀 SplicR Worker Starting..."\necho "   Node: $(node --version)"\necho "   Python: $(python3 --version)"\necho "   MAGeCK: $(mageck --version 2>&1 | head -1 || echo \"installed\")"\necho "   BAGEL2: $(test -x /opt/bagel2/BAGEL.py && echo \"installed\" || echo \"missing\")"\necho "   DrugZ: $(test -x /opt/drugz/drugz.py && echo \"installed\" || echo \"missing\")"\necho ""\ncd /app/frontend && exec npx tsx src/workers/analysis-worker.ts' > /app/start-worker.sh && \
    chmod +x /app/start-worker.sh

# Health check port (Railway requires this)
EXPOSE 8080

# Set production environment
ENV NODE_ENV=production
ENV PYTHONUNBUFFERED=1

# Start the worker
CMD ["/app/start-worker.sh"]
