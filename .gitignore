# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/

# Downloaded data: large, and some sources forbid redistribution.
# The READMEs that record provenance are kept.
data/references/
data/atlas/
data/cache/
data/testdata/*
!data/testdata/README.md
!data/testdata/*.json
*.fastq
*.fastq.gz
*.fq.gz
*.parquet

# supabase local
supabase/.branches
supabase/.temp

# misc
.DS_Store
*.pem
*.log
.vercel
.idea
.vscode/*
!.vscode/extensions.json
coverage/
engine/.tools/

# Workflow worktrees, created per agent and removed when unchanged.
.claude/worktrees/

# The reference lake is reproducible from scripts/data/build-lake.py and lives
# on R2. Same reasoning as data/references.
data/lake/

# Stray analysis caches. Scripts that need one write it to the scratchpad.
*.npy
*.pkl
engine/analysis/**/cache/
engine/analysis/**/*.log

# Reproducible external-tool intermediates; compact audit summaries are kept.
data/research/*/tools/

# Temporary measurement routes. Agents create these to measure geometry; they
# are never part of the app.
apps/web/src/app/dashboard/zz-probe/

# Keep reproducibility and test logs with the research evidence.
!research/artifacts/**/*.log
