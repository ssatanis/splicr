# SplicR configuration.
#
# Copy to .env and fill in. The web app reads apps/web/.env.local separately;
# both are gitignored. Nothing here is needed to browse the console in demo
# mode, which is the default when there is no session.
#
# Every name below is read by code in this repository. If you add one, add it
# here too, and if you remove the last reader, remove it from here.

# --- Supabase ---------------------------------------------------------------
# Project URL and the pooled Postgres connection string, both from
# Settings, Database in the Supabase dashboard. The engine talks to Postgres
# directly; the web app goes through the Data API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# The publishable key is safe in a browser. The secret key is not: it bypasses
# Row Level Security, so it stays server side and never reaches a client
# component.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# --- Modal ingest -----------------------------------------------------------
# Authenticated short-lived dispatch to the deployed queue gateway. Proxy
# tokens (wk-/ws-) differ from Modal SDK API tokens (ak-/as-). Keep both private.
# The gateway returns HTTP 202 while workers use the durable SQL queue.
MODAL_GATEWAY_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Set to 0 only for deployments that must never auto-start public ingest.
# SPLICR_INGEST_AUTOSTART=1

# --- Cloudflare R2 ----------------------------------------------------------
# Object storage for reference data and the Parquet lake. R2 speaks the S3 API,
# where the access key id is the API token id and the secret is the hex sha-256
# of the token value, which is not the usual S3 arrangement and catches people
# out. engine/splicr/r2.py derives it.
R2_ACCOUNT_ID=
R2_BUCKET=splicr
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Only needed to create buckets or tokens, not to read or write objects.
CLOUDFLARE_API_TOKEN=

# --- Paths ------------------------------------------------------------------
# Override where the engine looks for downloaded data. Defaults are
# data/references and data/testdata under the repository root.
# SPLICR_REFERENCE_DIR=
# SPLICR_TESTDATA_DIR=

# Read the Parquet lake from R2 instead of the local copy, which is what the
# freshness check does.
# SPLICR_LAKE_REMOTE=1

# DuckDB's memory ceiling when building the lake. The copy-number matrix
# unpivots to 74 million rows, so a small machine wants this lowered.
# SPLICR_DUCKDB_MEMORY=6GB

# --- Transactional mail -----------------------------------------------------
# The web app reads these from apps/web/.env.local in development and from the
# deployment's environment in production.
#
# Invitations and sign-in codes are composed and posted by SplicR, not by
# Supabase Auth: apps/web/src/lib/auth/invitations.ts mints the one-time code
# with the admin API, which sends nothing, and apps/web/src/lib/email/auth-codes.ts
# delivers it. Without RESEND_API_KEY that path falls back to asking Supabase to
# send, which is subject to the project's own SMTP settings and hourly email
# allowance, so a production deployment sets it.
RESEND_API_KEY=re_...
# The sender. Must be an address on a domain verified in Resend. Defaults to
# team@ the site's own hostname.
# RESEND_FROM_EMAIL=team@splicr.org
# Where a demo request is announced. Defaults to the address in lib/site.ts.
# DEMO_REQUEST_INBOX=team@splicr.org

# --- Web app ----------------------------------------------------------------
# Next.js reads .env files from the application root, so apps/web/.env.local is
# the web app's environment and this file is not: nothing here reaches it. A
# server-side name the web app needs has to appear in BOTH places in
# development, and in the deployment's environment in production.
#
# SUPABASE_SECRET_KEY is the one that bites. Without it createAdminClient()
# returns null, every invitation fails before a single message is attempted,
# and the members page can only report that the trusted client is not
# configured. A name without the NEXT_PUBLIC_ prefix is never bundled into the
# browser, so putting it in apps/web/.env.local exposes nothing; leaving it out
# breaks the front door of an invitation-only product.
#
# The origin every emailed verification route is built from, and the Supabase
# credentials the browser is allowed to hold.
NEXT_PUBLIC_SITE_URL=https://www.splicr.org
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
