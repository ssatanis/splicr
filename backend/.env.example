# Application
APP_NAME=SplicR API
DEBUG=False
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://splicr:splicr_dev_password@db:5432/splicr

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
S3_BUCKET_NAME=splicr-data-prod
AWS_BATCH_JOB_QUEUE=splicr-job-queue
AWS_BATCH_JOB_DEFINITION=splicr-analysis:1

# Security
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# CORS
CORS_ORIGINS=["http://localhost:3000","https://splicr.bio"]

# File Upload
MAX_UPLOAD_SIZE=10737418240

# Python analysis tools (Docker/Celery backend)
BAGEL2_PATH=/opt/analysis-tools/bagel
DRUGZ_PATH=/opt/analysis-tools/drugz

# API rate limits (requests per minute)
API_RATE_LIMIT_STANDARD=100
API_RATE_LIMIT_PRO=500
API_RATE_LIMIT_ENTERPRISE=2000
